# Kai-VPS-Infra / Bandwagon public configuration
# Runtime copy: /etc/kai-vps/bandwagon.env

ADMIN_USER=kai
TIMEZONE=Asia/Shanghai
SSH_PORT=22

# VLESS + REALITY
XRAY_VERSION=v26.6.27
REALITY_SNI=www.cloudflare.com
# Display name used by Mihomo / Shadowrocket subscriptions.
# Existing installations may omit this; 40-subscription.sh falls back to Kai-Xray-Reality.
NODE_NAME=Kai-Xray-Reality

# HTTPS subscription endpoint.
# If SUB_DOMAIN is blank and AUTO_SSLIP_DOMAIN=1, 50-nginx-cert.sh will derive
# <public-ip-with-dashes>.sslip.io automatically, so no purchased domain is required.
SUB_DOMAIN=
AUTO_SSLIP_DOMAIN=1
CERTBOT_EMAIL=
SUB_PORT=18080
SUB_HTTPS_PORT=8443

# Optional. Leave blank to auto-detect.
PUBLIC_IP=

# 1 = enable BBR when kernel supports it
ENABLE_BBR=1
